# Django and PostgreSQL
POSTGRES_DB=plantstalker
POSTGRES_USER=plantstalker
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_SECRET_KEY=change-me
DEBUG=False
MEDIA_DIR=/srv/plantstalker/media

# Camera devices and their upload tokens are managed in Django admin.

# Password reset emails
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=noreply@example.com

# Password reset
PASSWORD_RESET_TIMEOUT=900
PASSWORD_RESET_FRONTEND_URL=https://YOUR-FRONTEND-DOMAIN/reset-password